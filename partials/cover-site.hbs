{{#if @site.cover_image}}
    <div class="gh-cover-site-shell gh-outer">
        <div class="gh-inner">
            <section class="gh-cover gh-cover-site">
                <img
                    class="gh-cover-image"
                    srcset="{{img_url @site.cover_image size="s"}} 300w,
                            {{img_url @site.cover_image size="m"}} 720w,
                            {{img_url @site.cover_image size="l"}} 960w,
                            {{img_url @site.cover_image size="xl"}} 1200w,
                            {{img_url @site.cover_image size="xxl"}} 2000w"
                    sizes="(min-width: 1240px) 1200px, calc(100vw - 8rem)"
                    src="{{img_url @site.cover_image size="xl"}}"
                    alt="{{@site.title}}"
                >
{{!-- 
                <div class="gh-cover-content">
                    <h1 class="gh-cover-title">{{@site.title}}</h1>

                    {{#if @site.description}}
                        <p class="gh-cover-description">{{@site.description}}</p>
                    {{/if}}
                </div> --}}
            </section>

            {{> "cover-intro"}}
        </div>
    </div>
{{/if}}
